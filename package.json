{
  "name": "notebook-hand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An OTF handwriting font built from Anirudh's notebook, with contextual alternates and ligatures.",
  "scripts": {
    "build": "tsx src/build.ts",
    "dev": "tsx src/dev.ts",
    "check": "tsx src/check.ts",
    "serve": "tsx src/serve.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.26.2",
  "dependencies": {
    "js-angusj-clipper": "1.3.1",
    "opentype.js": "1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/opentype.js": "1.3.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
